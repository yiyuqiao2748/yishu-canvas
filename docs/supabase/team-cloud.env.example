# Copy these values into Render environment variables for the team cloud MVP.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
TEAM_AUTH_COOKIE_SECURE=1
TEAM_AUTH_COOKIE_NAME=team_cloud_access_token
TEAM_ASSET_MAX_BYTES=52428800
TEAM_ASSET_REQUIRE_R2=1

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=yishu-canvas-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://assets.your-domain.com

# Local development only. Do not enable this in production.
TEAM_AUTH_DEV_BYPASS=0
TEAM_AUTH_DEV_USER_ID=local-dev-user
TEAM_AUTH_DEV_EMAIL=dev@local.team
