# Copy these values into Render environment variables for the team cloud MVP.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Local development only. Do not enable this in production.
TEAM_AUTH_DEV_BYPASS=0
TEAM_AUTH_DEV_USER_ID=local-dev-user
TEAM_AUTH_DEV_EMAIL=dev@local.team
