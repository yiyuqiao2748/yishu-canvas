# Copy this file to .env on the NAS and fill in real values there.
# Do not commit .env.

# Cloudflare Zero Trust tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Public address configured in Cloudflare Public Hostname.
PUBLIC_BASE_URL=https://canvas.yiyuqiaoai.uk

# Team auth.
TEAM_AUTH_COOKIE_SECURE=true
TEAM_AUTH_DEV_BYPASS=false
TEAM_ASSET_MAX_BYTES=52428800
# Set to true after R2 is configured. If true, uploads fail clearly instead of falling back to NAS local disk.
TEAM_ASSET_REQUIRE_R2=false
# Server-side secret used to encrypt team API keys before saving them. Keep it stable after first deployment.
TEAM_API_SECRET_KEY=replace_with_a_long_random_secret

# Supabase Auth and database API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. If left empty, the backend verifies users through Supabase /auth/v1/user.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional R2/S3 compatible storage.
# First NAS deployment can leave these empty and use local NAS-mounted storage.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
